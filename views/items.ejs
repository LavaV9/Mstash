<%- include('partials/header') %>
<div class="listings">
    <% items.forEach(item => { %>
        <div class="item">
            <a href="/items/<%= item.id %>">
                <img height="400px" src="/images/<%= item.image %>" alt="<%= item.title %>">
            </a>
            <div class="details">
                <h2>
                    <a href="/items/<%= item.id %>" class="card-title"><%= item.title %></a>
                </h2>
                <p>Condition: <%= item.condition %></p>
                <p>Price: $<%= item.price %></p>
                <p>Seller: <%= item.seller %></p>
                <p><%= item.details %></p>
                <form action="/items/<%= item.id %>/edit" method="GET">
                    <button type="submit">Edit</button>
                </form>
                <form action="/items/<%= item.id %>?_method=DELETE" method="POST">
                    <button type="submit" onclick="return confirm('Are you sure you want to delete this item? You will have to reupload it?')">Delete</button>
                </form>
            </div>
        </div>
    <% }); %>
</div>
<%- include('partials/footer') %>
